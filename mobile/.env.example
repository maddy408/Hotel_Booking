# Expo inlines any EXPO_PUBLIC_* var into the JS bundle at build time.
# Development: point at your local PHP dev server's LAN IP (not localhost — the
# emulator/device is a separate machine from your dev machine), e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.102:8099
#
# Production (release APK): the deployed backend used by the web app too.
EXPO_PUBLIC_API_URL=https://hotel-booking.ethiodeploy.app
