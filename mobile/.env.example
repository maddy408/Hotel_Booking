# Expo inlines any EXPO_PUBLIC_* var into the JS bundle at build time.
# Point at your local backend server's LAN IP on port 8080 (the device is on the same Wi-Fi/LAN):
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.105:8080
# If testing using an Android emulator on the same PC:
# Example: EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
EXPO_PUBLIC_API_URL=http://192.168.1.105:8080
