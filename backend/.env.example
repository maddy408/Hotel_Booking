APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/tamarind-court/backend/public
APP_TIMEZONE=Asia/Kolkata
HOTEL_ID=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tamarind_court
DB_USERNAME=root
DB_PASSWORD=

# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Generate with: php -r "echo base64_encode(random_bytes(32));"
ENCRYPTION_KEY=base64:change-me-32-bytes-base64-encoded

# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
